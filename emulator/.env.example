# Copy to .env (git-ignored) and fill in.
# ACCEPT_EULA=Y accepts the Service Bus emulator EULA
# (https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt)
# and the SQL Server Linux EULA (https://go.microsoft.com/fwlink/?LinkId=746388).
ACCEPT_EULA="N"

# Local-only SQL Server SA password for the emulator's backing store (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=""
