<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ServiceBusCoordinator.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBrush" Color="#F6F8FA" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F6" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#DDE3EA" />
          <SolidColorBrush x:Key="HeaderRowBrush" Color="#F1F4F8" />
          <SolidColorBrush x:Key="RowAltBrush" Color="#F9FAFC" />
          <SolidColorBrush x:Key="MutedBrush" Color="#5C6878" />
          <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3EFFA" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE8E8" />
          <SolidColorBrush x:Key="DangerSolidBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="DangerSolidHoverBrush" Color="#A52317" />
          <SolidColorBrush x:Key="DangerSolidPressedBrush" Color="#8A1D13" />
          <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4D6" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#107C10" />
          <SolidColorBrush x:Key="QueueBrush" Color="#0F6CBD" />
          <SolidColorBrush x:Key="TopicBrush" Color="#8764B8" />
          <SolidColorBrush x:Key="SubscriptionBrush" Color="#03787C" />
          <SolidColorBrush x:Key="NamespaceBrush" Color="#0F6CBD" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBrush" Color="#16181C" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#1D2025" />
          <SolidColorBrush x:Key="CardBrush" Color="#22262C" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#33383F" />
          <SolidColorBrush x:Key="HeaderRowBrush" Color="#2A2E35" />
          <SolidColorBrush x:Key="RowAltBrush" Color="#25292F" />
          <SolidColorBrush x:Key="MutedBrush" Color="#9AA4B1" />
          <SolidColorBrush x:Key="AccentBrush" Color="#4FA3E8" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3448" />
          <SolidColorBrush x:Key="DangerBrush" Color="#FF8A80" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#4A2426" />
          <SolidColorBrush x:Key="DangerSolidBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="DangerSolidHoverBrush" Color="#D9372A" />
          <SolidColorBrush x:Key="DangerSolidPressedBrush" Color="#A52317" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F2C661" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#3D3218" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="QueueBrush" Color="#4FA3E8" />
          <SolidColorBrush x:Key="TopicBrush" Color="#B79CE6" />
          <SolidColorBrush x:Key="SubscriptionBrush" Color="#4CC2C4" />
          <SolidColorBrush x:Key="NamespaceBrush" Color="#4FA3E8" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" />
        <ColorPaletteResources x:Key="Dark" Accent="#2B88D8" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- Stat tiles -->
    <Style Selector="Border.stat">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Border.stat.alert">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.stat.alert TextBlock.statValue">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Banners -->
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.banner.update">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.danger">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.danger TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <!-- Pills / chips -->
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.pill.alert">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.alert > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.pill.muted">
      <Setter Property="Background" Value="{DynamicResource HeaderRowBrush}" />
    </Style>
    <Style Selector="Border.pill.muted > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Border.pill.warn">
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.warn > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- Entity-kind colours for icons -->
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="PathIcon.queue">
      <Setter Property="Foreground" Value="{DynamicResource QueueBrush}" />
    </Style>
    <Style Selector="PathIcon.topic">
      <Setter Property="Foreground" Value="{DynamicResource TopicBrush}" />
    </Style>
    <Style Selector="PathIcon.subscription">
      <Setter Property="Foreground" Value="{DynamicResource SubscriptionBrush}" />
    </Style>
    <Style Selector="PathIcon.namespace">
      <Setter Property="Foreground" Value="{DynamicResource NamespaceBrush}" />
    </Style>
    <Style Selector="PathIcon.folder">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <!-- Solid red, for destructive actions that should stand out (Purge) -->
    <Style Selector="Button.dangerSolid">
      <Setter Property="Background" Value="{DynamicResource DangerSolidBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.dangerSolid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSolidHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.dangerSolid:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSolidPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.dangerSolid:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Rectangle.divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Message list -->
    <Style Selector="Border.listHeader">
      <Setter Property="Background" Value="{DynamicResource HeaderRowBrush}" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.listHeader TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="ListBox.messages">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem:nth-child(2n)">
      <Setter Property="Background" Value="{DynamicResource RowAltBrush}" />
    </Style>

    <!-- Tree -->
    <Style Selector="TreeView.nav TreeViewItem">
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- Tabs: a little tighter than Fluent's default -->
    <Style Selector="TabControl.compact TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Application.Styles>
</Application>
