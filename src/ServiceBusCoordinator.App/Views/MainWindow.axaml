<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ServiceBusCoordinator.App"
        xmlns:vm="using:ServiceBusCoordinator.App.ViewModels"
        xmlns:core="using:ServiceBusCoordinator.Core.Models"
        xmlns:explorer="using:ServiceBusCoordinator.Core.Explorer"
        x:Class="ServiceBusCoordinator.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Service Bus Coordinator"
        Width="1440" Height="900" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="330,Auto,*">

      <!-- ===================== Sidebar ===================== -->
      <Border Grid.Column="0" Classes="sidebar">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                <PathIcon Data="{x:Static app:Icons.Topic}" Foreground="White" Width="16" Height="16" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Service Bus Coordinator" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="muted" FontSize="11" Text="Azure Service Bus explorer" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="4">
              <Button Grid.Column="0" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding AddConnectionCommand}" ToolTip.Tip="Add a namespace using a connection string">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{x:Static app:Icons.Plus}" Width="11" Height="11" />
                  <TextBlock Text="Add connection" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Command="{Binding AddEntityCommand}"
                      ToolTip.Tip="Add a queue or subscription by name (for connections without Manage rights)">
                <PathIcon Data="{x:Static app:Icons.AddEntity}" />
              </Button>
              <Button Grid.Column="2" Command="{Binding RefreshNamespaceCommand}" ToolTip.Tip="Reload the selected namespace">
                <PathIcon Data="{x:Static app:Icons.Refresh}" />
              </Button>
              <Button Grid.Column="3" Classes="danger" Command="{Binding RemoveConnectionCommand}" ToolTip.Tip="Remove the selected connection">
                <PathIcon Data="{x:Static app:Icons.Trash}" />
              </Button>
              <Button Grid.Column="4" Command="{Binding EditOptionsCommand}" ToolTip.Tip="Options">
                <PathIcon Data="{x:Static app:Icons.Settings}" />
              </Button>
            </Grid>

            <Border Classes="banner update" IsVisible="{Binding HasUpdate}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{x:Static app:Icons.Download}" Width="14" Height="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding UpdateTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="2" Classes="subtle" Padding="4,0" Content="✕" FontSize="11" Command="{Binding DismissUpdateCommand}"
                          IsVisible="{Binding !IsUpdating}" ToolTip.Tip="Hide until next start" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="4" MinHeight="4" IsVisible="{Binding IsUpdating}" />
                <TextBlock Text="{Binding UpdateError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding UpdateError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="accent" Content="Update and restart" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding CanInstallUpdate}" />
                  <Button Classes="accent" Content="Download" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding CanOnlyDownloadUpdate}"
                          ToolTip.Tip="Open the release page to download it" />
                  <Button Content="What's new" Command="{Binding OpenReleasePageCommand}" IsVisible="{Binding CanInstallUpdate}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="banner" IsVisible="{Binding StorageWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding StorageWarning}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <TextBlock Classes="section" Text="NAMESPACES" Margin="2,4,0,-6" />
          </StackPanel>

          <Panel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Margin="16,4" FontSize="12"
                       IsVisible="{Binding HasNoConnections}"
                       Text="No connections yet. Click 'Add connection' and paste a Service Bus connection string." />
            <TreeView x:Name="NavTree" Classes="nav" ItemsSource="{Binding Namespaces}" SelectedItem="{Binding SelectedNode}" Margin="4,0,4,8"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <TreeView.ContextMenu>
                <!-- Right-click selects the item first, so these act on SelectedNode. -->
                <ContextMenu>
                  <MenuItem Header="{Binding SelectedNode.Title}" IsEnabled="False" FontWeight="SemiBold" />
                  <Separator />
                  <MenuItem Header="Refresh" Command="{Binding RefreshSelectedCommand}">
                    <MenuItem.Icon>
                      <PathIcon Data="{x:Static app:Icons.Refresh}" Width="12" Height="12" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding CanPurgeSelectedNode}" />
                  <MenuItem Header="Purge active messages…" IsVisible="{Binding CanPurgeSelectedNode}"
                            Command="{Binding PurgeSelectedCommand}" CommandParameter="{x:Static core:MessageSource.Active}">
                    <MenuItem.Icon>
                      <PathIcon Data="{x:Static app:Icons.Trash}" Width="12" Height="12" Foreground="{DynamicResource DangerBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Purge dead-letter queue…" IsVisible="{Binding CanPurgeSelectedNode}"
                            Command="{Binding PurgeSelectedCommand}" CommandParameter="{x:Static core:MessageSource.DeadLetter}">
                    <MenuItem.Icon>
                      <PathIcon Data="{x:Static app:Icons.Trash}" Width="12" Height="12" Foreground="{DynamicResource DangerBrush}" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:NamespaceNodeViewModel" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                    <PathIcon Classes="namespace" Data="{Binding Icon}" Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Host}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                      <TextBlock Text="loading…" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" />
                      <Border Classes="pill" IsVisible="{Binding IsEmulator}" ToolTip.Tip="Local Service Bus emulator">
                        <TextBlock Text="emulator" />
                      </Border>
                      <Border Classes="pill warn" ToolTip.Tip="{Binding LimitedAccessReason}"
                              IsVisible="{Binding LimitedAccessReason, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="limited" />
                      </Border>
                      <Border Classes="pill alert" ToolTip.Tip="{Binding Error}"
                              IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="error" />
                      </Border>
                      <Border Classes="pill alert" ToolTip.Tip="Dead-lettered messages across this namespace"
                              IsVisible="{Binding AlertBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding AlertBadge}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
                <TreeDataTemplate DataType="vm:PlaceholderNodeViewModel">
                  <TextBlock Text="{Binding Text}" Classes="muted" FontSize="12" FontStyle="Italic" Margin="0,2" TextTrimming="CharacterEllipsis" />
                </TreeDataTemplate>
                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{Binding Icon}" VerticalAlignment="Center"
                              Classes.queue="{Binding IsQueue}" Classes.topic="{Binding IsTopic}"
                              Classes.subscription="{Binding IsSubscription}" Classes.folder="{Binding IsFolder}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    <Border Classes="pill" IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Badge}" />
                    </Border>
                    <Border Classes="pill" Classes.alert="{Binding HasDeadLetters}" Classes.muted="{Binding !HasDeadLetters}"
                            ToolTip.Tip="Dead-lettered messages"
                            IsVisible="{Binding DeadLetterBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding DeadLetterBadge}" />
                    </Border>
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.DataTemplates>
            </TreeView>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Background="Transparent" />

      <!-- ===================== Content ===================== -->
      <Panel Grid.Column="2" Margin="20,16,20,12">

        <!-- Empty state: no connections -->
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="32,28"
                IsVisible="{Binding HasNoConnections}">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
              <PathIcon Classes="namespace" Data="{x:Static app:Icons.Namespace}" Width="26" Height="26" />
            </Border>
            <TextBlock Classes="h2" Text="Connect to a Service Bus namespace" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Paste a connection string to browse queues, topics and subscriptions, peek messages, purge, and move dead-lettered messages back." />
            <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding AddConnectionCommand}" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{x:Static app:Icons.Plus}" Width="11" Height="11" />
                <TextBlock Text="Add connection" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Nothing selected / namespace selected -->
        <Panel IsVisible="{Binding !HasEntity}">
          <StackPanel IsVisible="{Binding !HasNoConnections}">
            <TextBlock Classes="muted" Margin="0,60,0,0" HorizontalAlignment="Center"
                       IsVisible="{Binding SelectedNamespace, Converter={x:Static ObjectConverters.IsNull}}"
                       Text="Select a namespace, queue, topic or subscription on the left." />

            <StackPanel Spacing="14" IsVisible="{Binding SelectedNamespace, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                  <PathIcon Classes="namespace" Data="{x:Static app:Icons.Namespace}" Width="22" Height="22" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="h1" Text="{Binding SelectedNamespace.Title}" />
                    <Border Classes="pill" VerticalAlignment="Center"><TextBlock Text="Namespace" /></Border>
                  </StackPanel>
                  <TextBlock Classes="muted mono" Text="{Binding SelectedNamespace.Host}" />
                </StackPanel>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding SelectedNamespace.CanConnect, FallbackValue=False}">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding SelectedNamespace.ConnectPrompt}" />
                <Button Classes="accent" Content="{Binding SelectedNamespace.ConnectLabel}" Command="{Binding SelectedNamespace.ConnectCommand}" />
              </StackPanel>
              <TextBlock Text="Connecting and loading entities…" Classes="muted" IsVisible="{Binding SelectedNamespace.IsLoading}" />
              <Border Classes="danger" IsVisible="{Binding SelectedNamespace.Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedNamespace.Error}" TextWrapping="Wrap" />
              </Border>
              <Border Classes="banner" IsVisible="{Binding SelectedNamespace.LimitedAccessReason, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedNamespace.LimitedAccessReason}" TextWrapping="Wrap" />
              </Border>

              <WrapPanel IsVisible="{Binding SelectedNamespace.Summary, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Classes="stat">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="ENTITIES" />
                    <TextBlock Text="{Binding SelectedNamespace.Summary}" FontSize="15" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Classes="stat" Classes.alert="{Binding SelectedNamespace.AlertBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="DEAD-LETTERED" />
                    <TextBlock Classes="statValue" Text="{Binding SelectedNamespace.TotalDeadLetters, StringFormat={}{0:N0}}" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <TextBlock Classes="muted" Text="Select a queue, topic or subscription to see its messages and properties."
                         IsVisible="{Binding SelectedNamespace.IsConnected, FallbackValue=False}" />
            </StackPanel>
          </StackPanel>
        </Panel>

        <!-- Entity -->
        <Panel IsVisible="{Binding HasEntity}">
          <DockPanel DataContext="{Binding CurrentEntity}" x:DataType="vm:EntityViewModel">

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,*">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                  <PathIcon Data="{Binding Icon}" Width="22" Height="22"
                            Classes.queue="{Binding IsQueue}" Classes.topic="{Binding IsTopic}" Classes.subscription="{Binding IsSubscription}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="h1" Text="{Binding Title}" />
                    <Border Classes="pill"><TextBlock Text="{Binding KindName}" /></Border>
                    <Border Classes="pill warn" IsVisible="{Binding RequiresSession}"><TextBlock Text="Sessions" /></Border>
                    <Border Classes="pill warn" IsVisible="{Binding IsManual}"><TextBlock Text="Added manually" /></Border>
                  </StackPanel>
                  <TextBlock Classes="muted mono" Text="{Binding PathText}" />
                </StackPanel>
              </Grid>

              <WrapPanel IsVisible="{Binding HasCounts}">
                <Border Classes="stat">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="ACTIVE" />
                    <TextBlock Classes="statValue" Text="{Binding ActiveCount}" />
                  </StackPanel>
                </Border>
                <Border Classes="stat" Classes.alert="{Binding HasDeadLetters}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="DEAD-LETTER" />
                    <TextBlock Classes="statValue" Text="{Binding DeadLetterCount}" />
                  </StackPanel>
                </Border>
                <Border Classes="stat" IsVisible="{Binding IsQueue}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="SCHEDULED" />
                    <TextBlock Classes="statValue" Text="{Binding ScheduledCount}" />
                  </StackPanel>
                </Border>
                <Border Classes="stat">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="section" Text="TRANSFER DLQ" />
                    <TextBlock Classes="statValue" Text="{Binding TransferDeadLetterCount}" />
                  </StackPanel>
                </Border>
              </WrapPanel>
            </StackPanel>

            <TabControl Classes="compact" SelectedIndex="{Binding SelectedTabIndex}" Padding="0">

              <!-- ===== Messages ===== -->
              <TabItem Header="Messages" IsVisible="{Binding HasMessages}">
                <DockPanel Margin="0,10,0,0">
                  <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                    <Border Classes="toolbar">
                      <WrapPanel>
                        <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" IsEnabled="{Binding !IsBusy}"
                                  MinWidth="180" Margin="0,2,6,2" VerticalAlignment="Center" ToolTip.Tip="Which sub-queue to show">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceOption">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Command="{Binding RefreshCommand}" Margin="0,2,4,2" ToolTip.Tip="Reload messages and counts">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Refresh}" Width="12" Height="12" />
                            <TextBlock Text="Refresh" />
                          </StackPanel>
                        </Button>
                        <Button Content="Load more" Command="{Binding LoadMoreCommand}" Margin="0,2,0,2" />

                        <Rectangle Classes="divider" IsVisible="{Binding IsDeadLetterSource}" />
                        <Button Command="{Binding ResubmitSelectedCommand}" Margin="0,2,4,2" IsVisible="{Binding IsDeadLetterSource}"
                                ToolTip.Tip="Move the ticked messages back to the main entity">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Resubmit}" Width="12" Height="12" />
                            <TextBlock Text="Resubmit selected" />
                          </StackPanel>
                        </Button>
                        <Button Content="Resubmit all" Command="{Binding ResubmitAllCommand}" Margin="0,2,0,2" IsVisible="{Binding IsDeadLetterSource}" />

                        <Rectangle Classes="divider" />
                        <Button Command="{Binding SendMessageCommand}" Margin="0,2,4,2"
                                ToolTip.Tip="Compose and send a new message (to the topic, for a subscription)">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Send}" Width="12" Height="12" />
                            <TextBlock Text="Send" />
                          </StackPanel>
                        </Button>
                        <Button Content="Edit &amp; resend" Command="{Binding ResendCommand}" Margin="0,2,0,2"
                                ToolTip.Tip="Send a copy of the selected message, edited first" />

                        <Rectangle Classes="divider" />
                        <Button Command="{Binding ExportCommand}" Margin="0,2,4,2"
                                ToolTip.Tip="Save the ticked messages (or all shown) to a JSON file">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Export}" Width="12" Height="12" />
                            <TextBlock Text="Export" />
                          </StackPanel>
                        </Button>
                        <Button Content="Export all" Command="{Binding ExportAllCommand}" Margin="0,2,0,2"
                                ToolTip.Tip="Read the whole sub-queue (up to 10,000 messages) and save it to a JSON file" />

                        <Rectangle Classes="divider" />
                        <Button Content="Cancel scheduled" Command="{Binding CancelScheduledCommand}" Margin="0,2,4,2"
                                IsVisible="{Binding CanCancelScheduledHere}" ToolTip.Tip="Cancel the ticked scheduled messages" />
                        <Button Content="Delete deferred" Command="{Binding DeleteDeferredCommand}" Margin="0,2,4,2"
                                ToolTip.Tip="Delete the ticked deferred messages" />
                        <Rectangle Classes="divider" />
                        <Button Classes="dangerSolid" Command="{Binding PurgeCommand}" Margin="0,2,0,2"
                                ToolTip.Tip="Permanently delete every message in this sub-queue">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static app:Icons.Trash}" Width="12" Height="12" />
                            <TextBlock Text="Purge" />
                          </StackPanel>
                        </Button>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="10,2,0,2" IsVisible="{Binding IsBusy}" />
                      </WrapPanel>
                    </Border>

                    <!-- Sessions: active messages of a session-enabled entity are browsed one session at a time -->
                    <Border Classes="banner" IsVisible="{Binding IsSessionMode}">
                      <StackPanel Spacing="6">
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Text="Session-enabled: messages are shown one session at a time. Opening or finding sessions briefly locks them, which pauses consumers of those sessions for a few seconds." />
                        <WrapPanel>
                          <TextBox Text="{Binding SessionId}" PlaceholderText="Session ID" MinWidth="220" Margin="0,0,4,4" />
                          <Button Content="Open" Command="{Binding OpenSessionCommand}" Margin="0,0,4,4" />
                          <Button Content="Next available" Command="{Binding NextSessionCommand}" Margin="0,0,12,4" />
                          <Button Content="Find sessions" Command="{Binding FindSessionsCommand}" Margin="0,0,4,4" />
                          <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MinWidth="220"
                                    PlaceholderText="Found sessions" Margin="0,0,12,4">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="core:SessionSummary">
                                <TextBlock Text="{Binding SessionId}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Button Content="Clear state…" Command="{Binding ClearSessionStateCommand}" Margin="0,0,4,4" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding SessionStateText, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <TextBlock Text="Session state:" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Classes="mono" Text="{Binding SessionStateText}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="danger" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>

                    <TextBox Text="{Binding FilterText}"
                             PlaceholderText="Filter loaded messages — text, sequence number, or property=value"
                             ToolTip.Tip="Searches IDs, subject, dead-letter reason, application properties and the body of the loaded messages">
                      <TextBox.InnerLeftContent>
                        <PathIcon Data="{x:Static app:Icons.Filter}" Width="12" Height="12" Margin="10,0,2,0" Foreground="{DynamicResource MutedBrush}" />
                      </TextBox.InnerLeftContent>
                      <TextBox.InnerRightContent>
                        <TextBlock Text="{Binding FilterSummary}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="6,0,10,0" />
                      </TextBox.InnerRightContent>
                    </TextBox>
                  </StackPanel>

                  <Grid RowDefinitions="3*,8,2*">
                    <!-- Message list -->
                    <Border Grid.Row="0" Classes="card" Padding="0">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="listHeader">
                          <Grid ColumnDefinitions="36,76,84,1.2*,*,150,46,1.3*,2*">
                            <CheckBox Grid.Column="0" ToolTip.Tip="Tick / untick all" MinHeight="0" Padding="0"
                                      Command="{Binding CheckAllCommand}" CommandParameter="{Binding $self.IsChecked}" />
                            <TextBlock Grid.Column="1" Text="SEQ #" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="STATE" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="MESSAGE ID" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="SUBJECT" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="ENQUEUED" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="TRIES" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="DEAD-LETTER REASON" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="8" Text="BODY" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                        <ListBox Classes="messages" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageRowViewModel">
                              <Grid ColumnDefinitions="36,76,84,1.2*,*,150,46,1.3*,2*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" MinHeight="0" Padding="0" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SequenceNumber}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="pill" HorizontalAlignment="Left"
                                        IsVisible="{Binding StateLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                  <TextBlock Text="{Binding StateLabel}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding MessageId}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="4" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="5" Text="{Binding Enqueued}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{Binding DeliveryCount}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{Binding DeadLetterReason}" Foreground="{DynamicResource DangerBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="8" Classes="mono muted" Text="{Binding BodyPreview}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

                    <!-- Message detail -->
                    <Border Grid.Row="2" Classes="card" Padding="12,0,12,12">
                      <TabControl Classes="compact" Padding="0" DataContext="{Binding SelectedMessage}" x:DataType="vm:MessageRowViewModel">
                        <TabItem Header="Body">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="pill" HorizontalAlignment="Left" Margin="0,4,0,6"
                                    IsVisible="{Binding BodyKindLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding BodyKindLabel}" />
                            </Border>
                            <TextBox Text="{Binding BodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" />
                          </DockPanel>
                        </TabItem>
                        <TabItem Header="Properties">
                          <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding SystemProperties}" Margin="0,6,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropertyRow">
                                  <Grid ColumnDefinitions="220,*" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" Classes="muted" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Application properties">
                          <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ApplicationProperties}" Margin="0,6,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropertyRow">
                                  <Grid ColumnDefinitions="220,*" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" Classes="muted" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </TabItem>
                      </TabControl>
                    </Border>
                  </Grid>
                </DockPanel>
              </TabItem>

              <!-- ===== Entity properties ===== -->
              <TabItem Header="Properties">
                <ScrollViewer Margin="0,10,0,0">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Loading properties…" Classes="muted" IsVisible="{Binding IsLoadingDetails}" />
                    <Border Classes="banner" IsVisible="{Binding DetailsMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <TextBlock Text="{Binding DetailsMessage}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding DetailGroups}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explorer:DetailGroup">
                          <Border Classes="card" Width="440" Margin="0,0,12,12" VerticalAlignment="Top">
                            <StackPanel Spacing="8">
                              <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="explorer:DetailItem">
                                    <Grid ColumnDefinitions="190,*" Margin="0,3">
                                      <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap" />
                                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                           FontWeight="SemiBold" ToolTip.Tip="{Binding Hint}" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Subscription rules -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasRules}">
                      <TextBlock Classes="h2" Text="Rules" />
                      <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !Rules.Count}"
                                 Text="No rules: this subscription receives no messages." />
                      <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="explorer:RuleDetails">
                            <Border Classes="card" Margin="0,0,12,10" MaxWidth="892" HorizontalAlignment="Left">
                              <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <PathIcon Data="{x:Static app:Icons.Filter}" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}" />
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                  <Border Classes="pill"><TextBlock Text="{Binding FilterKind}" /></Border>
                                </StackPanel>
                                <SelectableTextBlock Classes="mono" Text="{Binding Filter}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding Action, Converter={x:Static ObjectConverters.IsNotNull}}">
                                  <PathIcon Data="{x:Static app:Icons.Lightning}" Width="12" Height="12" Foreground="{DynamicResource WarningBrush}" />
                                  <SelectableTextBlock Classes="mono" Text="{Binding Action}" TextWrapping="Wrap" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Panel>
      </Panel>
    </Grid>

    <!-- ===================== Status bar ===================== -->
    <Border Grid.Row="1" Classes="statusbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="subtle link" Content="Options" Command="{Binding EditOptionsCommand}" Padding="0" FontSize="11" />
          <Button Classes="subtle link" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Padding="0" FontSize="11" />
          <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="{Binding AppVersion, StringFormat='v{0}'}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="80" Height="4" MinHeight="4" VerticalAlignment="Center"
                       IsVisible="{Binding CurrentEntity.IsBusy, FallbackValue=False}" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding CurrentEntity.StatusText, FallbackValue=Ready, TargetNullValue=Ready}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
